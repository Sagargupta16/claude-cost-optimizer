{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "model": "claude-sonnet-5",

  "permissions": {
    "allow": [
      "Read(**)",
      "Bash(python tools/claude-rate/rate.py:*)",
      "Bash(python tools/badge-generator/generate.py:*)",
      "Bash(python scripts/check-pricing-sync.py:*)",
      "Bash(python scripts/check-links.py:*)",
      "Bash(python -m compileall:*)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npx tsc:*)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "bash hooks/budget-tracker.sh" }]
      },
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "bash hooks/cost-logger.sh" }]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [{ "type": "command", "command": "bash hooks/session-summary.sh" }]
      }
    ]
  }
}
